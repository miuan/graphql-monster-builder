{
  "name": "graphql-monster-builder",
  "version": "0.1.6",
  "author": "Milan Medlik <milan.medlik@gmail.com>",
  "license": "MIT",
  "bin": "./bin/cli.js",
  "scripts": {
    "prepublish": "npm run build",
    "preinstall": "npm run build",
    "build": "tsc index.ts --target es2020 --module commonjs --skipLibCheck --outDir dist/",
    "postbuild": "npm run copy:templates && npm run copy:package",
    "copy:templates": "copyfiles -u ./services/backend/templates/* ./services/backend/templates/*/** ./dist/",
    "copy:package": "copyfiles ./package.json ./dist/",
    "build:todo": "npx ts-node index.ts -bd -d ./examples/todo.schema server3",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:all": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watchAll",
    "lint": "eslint .",
    "prettier-format": "prettier --config .prettierrc.js 'services/**/*.spec.ts' --write",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@types/node": "^14.14.9",
    "dotenv-flow": "^3.2.0",
    "json2yaml": "^1.1.0",
    "lodash": "^4.17.15",
    "loglevel": "^1.7.0",
    "loglevel-plugin-prefix": "^0.8.4",
    "ramda": "^0.27.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "yargs": "^15.3.1"
  },
  "devDependencies": {
    "@koa/cors": "^5.0.0",
    "bcrypt": "^6.0.0",
    "copyfiles": "^2.4.1",
    "dataloader": "^2.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^16.11.0",
    "jest": "^29.7.0",
    "jest-extended": "^7.0.0",
    "json5": "^2.2.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.0.0",
    "koa-body": "^7.0.1",
    "koa-passport": "^6.0.0",
    "koa-send": "^5.0.1",
    "mongoose": "^9.12.1",
    "passport-anonymous": "^1.0.1",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prettier": "^3.9.10",
    "supertest": "^6.1.3",
    "swagger-jsdoc": "^6.3.0",
    "ts-jest": "^29.4.5",
    "@apollo/server": "^5.5.1",
    "@as-integrations/koa": "^2.0.0",
    "@graphql-tools/schema": "^10.1.5",
    "@graphql-tools/utils": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@koa/router": "^15.7.1",
    "koa2-swagger-ui": "^5.12.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.72.2",
    "globals": "^17.4.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "overrides": {
    "swagger-jsdoc": {
      "glob": "^14.0.4"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "resolutions": {
    "swagger-jsdoc/glob": "^14.0.4",
    "eslint/minimatch": "^11.0.8",
    "@eslint/config-array/minimatch": "^11.0.8",
    "@typescript-eslint/typescript-estree/minimatch": "^11.0.8"
  }
}
