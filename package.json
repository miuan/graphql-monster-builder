{
  "name": "graphql-monster-builder",
  "version": "0.1.6",
  "author": "Milan Medlik <milan.medlik@gmail.com>",
  "license": "MIT",
  "bin": "./bin/cli.js",
  "scripts": {
    "prepublish": "npm run build",
    "preinstall": "npm run build",
    "build": "tsc index.ts --target es2020 --module commonjs --skipLibCheck --outDir dist/",
    "postbuild": "npm run copy:templates && npm run copy:package",
    "copy:templates": "copyfiles -u ./services/backend/templates/* ./services/backend/templates/*/** ./dist/",
    "copy:package": "copyfiles ./package.json ./dist/",
    "build:todo": "npx ts-node index.ts -bd -d ./examples/todo.schema server3",
    "test": "jest",
    "test:all": "jest --watchAll",
    "lint": "eslint \"*/**/*.{js,ts}\" --quiet --fix",
    "prettier-format": "prettier --config .prettierrc 'services/**/*.spec.ts' --write"
  },
  "dependencies": {
    "@types/node": "^14.14.9",
    "dotenv-flow": "^3.2.0",
    "json2yaml": "^1.1.0",
    "lodash": "^4.17.15",
    "loglevel": "^1.7.0",
    "loglevel-plugin-prefix": "^0.8.4",
    "ramda": "^0.27.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "yargs": "^15.3.1"
  },
  "devDependencies": {
    "@koa/cors": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^4.25.0",
    "@typescript-eslint/parser": "^4.25.0",
    "bcrypt": "^5.0.1",
    "copyfiles": "^2.4.1",
    "dataloader": "^2.0.0",
    "eslint": "^7.27.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "graphql": "^16.11.0",
    "jest": "^29.7.0",
    "jest-extended": "^0.11.5",
    "json5": "^2.2.0",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.0.0",
    "koa-body": "^4.2.0",
    "koa-passport": "^4.1.4",
    "koa-router": "^10.0.0",
    "koa-send": "^5.0.1",
    "mongoose": "^5.12.10",
    "passport-anonymous": "^1.0.1",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prettier": "^2.3.0",
    "supertest": "^6.1.3",
    "swagger-jsdoc": "^6.1.0",
    "swagger2": "^3.0.0",
    "swagger2-koa": "^3.0.0",
    "ts-jest": "^29.4.5",
    "@apollo/server": "^5.5.1",
    "@as-integrations/koa": "^2.0.0",
    "@graphql-tools/schema": "^10.1.5",
    "@graphql-tools/utils": "^10.11.0",
    "@types/jest": "^29.5.14"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
